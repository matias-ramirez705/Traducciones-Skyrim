    "form_id": "050DB2C3|cceejsse005-cave.esm",
    "index": 1,
    "type": "INFO RNAM",
    "original": "Los miembros de la Guardia del Alba y los nobles están muertos.",
    "string": "La Guardia del Alba y los nobles están muertos, sí.  ",
    "status": "TranslationComplete"
  },
  {
