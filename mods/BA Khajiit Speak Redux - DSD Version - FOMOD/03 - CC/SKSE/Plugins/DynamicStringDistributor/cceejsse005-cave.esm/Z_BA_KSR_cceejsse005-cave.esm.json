    "status": "TranslationComplete"
  },
  {
    "editor_id": "ccEEJSSE005_Branch03Topic",
    "form_id": "050BCC67|cceejsse005-cave.esm",
    "index": 1,
    "type": "DIAL FULL",
    "original": "Me gustaría ver el menú, por favor.",
