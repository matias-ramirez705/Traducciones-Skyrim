    "status": "TranslationComplete"
  },
  {
    "editor_id": "ccEEJSSE005_Quest100talkTopic",
    "form_id": "050DB2AF|cceejsse005-cave.esm",
    "index": 1,
    "type": "DIAL FULL",
    "original": "Todos los vampiros están muertos, y el testamento dice que la casa me pertenece.",
    "string": "Los vampiros están todos muertos y el testamento dice que la casa ahora pertenece a Khajiit. Qué afortunado, ¿sí?  ",
