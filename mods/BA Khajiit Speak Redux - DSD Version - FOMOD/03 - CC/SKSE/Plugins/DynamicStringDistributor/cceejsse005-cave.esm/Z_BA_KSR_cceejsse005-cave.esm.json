    "status": "TranslationComplete"
  },
  {
    "editor_id": "ccEEJSSE005_Branch04Topic",
    "form_id": "050BCC69|cceejsse005-cave.esm",
    "index": 1,
    "type": "DIAL FULL",
    "original": "Quiero ir a mi asiento. Ya.",
