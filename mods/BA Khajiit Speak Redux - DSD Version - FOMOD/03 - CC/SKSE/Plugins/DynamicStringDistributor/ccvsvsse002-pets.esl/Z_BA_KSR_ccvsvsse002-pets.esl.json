  {
    "editor_id": "ccVSVSSE002_msg_QuestDone_Skeever",
    "form_id": "050008FE|ccvsvsse002-pets.esl",
    "index": 1,
    "type": "MESG DESC",
    "original": "¡<Alias=AliasSkeever> el skeever ya está disponible para reclutarlo como mascota!\r\nPuedes ordenar a <Alias=AliasSkeever> que te guíe hacia alimentos cercanos. Además, puede encontrar un alimento cada día.",
    "string": "<Alias=AliasSkeever> la rata gigante ahora está disponible para ser reclutada como mascota!  \r\n\r\n<Alias=AliasSkeever> puede recibir la orden de buscar comida cercana.  \r\n\r\n<Alias=AliasSkeever> también tiene la posibilidad de encontrar comida al azar una vez por día.",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "ccVSVSSE002_msg_QuestDone_Fox",
    "form_id": "050008FF|ccvsvsse002-pets.esl",
    "index": 1,
    "type": "MESG DESC",
    "original": "¡<Alias=AliasFox> el zorro ya está disponible para reclutarlo como mascota!\r\nPuedes ordenar a <Alias=AliasFox> que te lleve a los objetos de valor que haya cerca. Además, puede encontrar un objeto reluciente cada día.",
    "string": "<Alias=AliasFox> el zorro ahora está disponible para ser reclutado como mascota!  \r\n\r\n<Alias=AliasFox> puede recibir la orden de buscar objetos valiosos cercanos.  \r\n\r\n<Alias=AliasFox> también tiene la posibilidad de encontrar un objeto brillante al azar una vez por día!",
    "status": "TranslationComplete"
  },
