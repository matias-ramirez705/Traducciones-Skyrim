    "form_id": "05000901|ccvsvsse002-pets.esl",
    "index": 1,
    "type": "MESG DESC",
    "original": "¡<Alias=AliasRabbit> el conejo ya está disponible para reclutarlo como mascota!\r\nPuedes ordenar a <Alias=AliasRabbit> que te guíe hacia ingredientes cercanos. Además, puede encontrar un ingrediente cada día.",
    "string": "<Alias=AliasRabbit> el conejo ahora está disponible para ser reclutado como mascota!  \r\n\r\n<Alias=AliasRabbit> puede recibir la orden de encontrar ingredientes cercanos.  \r\n\r\n<Alias=AliasRabbit> también tiene la posibilidad de encontrar un ingrediente al azar una vez por día.",
    "status": "TranslationComplete"
  },
