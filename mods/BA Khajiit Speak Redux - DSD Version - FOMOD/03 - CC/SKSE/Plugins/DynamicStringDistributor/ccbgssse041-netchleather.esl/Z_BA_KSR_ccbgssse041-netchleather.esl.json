  },
  {
    "editor_id": "ccBGSSSE041_DialogueQuestTopicA",
    "form_id": "05000841|ccbgssse041-netchleather.esl",
    "index": 1,
    "type": "DIAL FULL",
    "original": "Quizá os lo pueda conseguir.",
    "string": "Quizás este pueda ayudarte a encontrar algo, sí?  ",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "ccBGSSSE041_DialogueQuestTopicB",
