    "index": 1,
    "type": "DIAL FULL",
    "original": "Cuero. ¿Lo quieres?",
    "string": "Cuero. Te gustaría tenerlo, quizás?  ",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "ccBGSSSE041_DialogueQuestTopicC",
    "form_id": "05000845|ccbgssse041-netchleather.esl",
    "index": 1,
    "type": "DIAL FULL",
    "original": "Lo siento. No te he entendido. ¿Puedes repetírmelo?",
