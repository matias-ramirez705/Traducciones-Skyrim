msgstr "Oculto:"

#: res/xrc/Automation.xrc:2948
msgid "Set the hidden flag on matching sliders."
msgstr "Establecer la marca oculto en los deslizadores coincidentes."

#: res/xrc/Automation.xrc:2955
msgid "Default Zapped:"
msgstr "Zap predeterminado:"

#: res/xrc/Automation.xrc:2963
