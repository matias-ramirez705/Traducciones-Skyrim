msgid "Symmetrize Vertices..."
msgstr "Simetrizar Vértices..."

#: res/xrc/OutfitStudio.xrc:2514 res/xrc/OutfitStudio.xrc:3010
msgid "Changes vertex data to be identical to mirrored vertices."
msgstr "Cambia los datos del vértice para que sean idénticos a los vértices reflejados."

#: res/xrc/OutfitStudio.xrc:2517 res/xrc/OutfitStudio.xrc:3013
msgid "Mask Symmetric Triangles"
msgstr "Máscara de Triángulos Simétricos"

#: res/xrc/OutfitStudio.xrc:2518 res/xrc/OutfitStudio.xrc:3014
msgid "Masks triangles that can be matched to a mirrored triangle."
msgstr "Aplica máscara a triángulos que pueden coincidir con un triángulo reflejado."

#: res/xrc/OutfitStudio.xrc:2522 res/xrc/OutfitStudio.xrc:3018
msgid "Delete\tDel"
msgstr "Eliminar\tSupr"

#: res/xrc/OutfitStudio.xrc:2523 res/xrc/OutfitStudio.xrc:3019
msgid "Removes the currently selected shape from the outfit."
msgstr "Elimina la forma seleccionada actualmente del atuendo."

#: res/xrc/OutfitStudio.xrc:2529 res/xrc/OutfitStudio.xrc:3022
msgid "Properties..."
msgstr "Propiedades..."

