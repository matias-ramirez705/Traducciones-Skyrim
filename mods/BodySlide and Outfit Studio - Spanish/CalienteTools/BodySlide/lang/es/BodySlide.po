msgstr "Renombrar...\tF2"

#: res/xrc/OutfitStudio.xrc:2434 res/xrc/OutfitStudio.xrc:2950
msgid "Change the name of the current shape."
msgstr "Cambia el nombre de la forma actual."

#: res/xrc/OutfitStudio.xrc:2437 res/xrc/OutfitStudio.xrc:2953
msgid "Set Reference"
msgstr "Establecer Referencia"

