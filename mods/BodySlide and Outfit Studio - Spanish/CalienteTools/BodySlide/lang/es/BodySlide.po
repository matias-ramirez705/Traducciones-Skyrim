msgid "Copies partitions/segments and all triangle assignments from the reference shape to the current shape."
msgstr "Copia particiones/segmentos y todas las asignaciones de triángulos de la forma de referencia a la forma actual."

#: res/xrc/OutfitStudio.xrc:2509 res/xrc/OutfitStudio.xrc:3005
msgid "Mask Symmetric Vertices..."
msgstr "Máscara de Vértices Simétricos..."

#: res/xrc/OutfitStudio.xrc:2510 res/xrc/OutfitStudio.xrc:3006
msgid "Masks unmasked vertices that have a mirrored vertex with identical data."
msgstr "Aplica máscara a vértices sin máscara que tienen un vértice reflejado con datos idénticos."

