msgid "Copy Selected Weights"
msgstr "Copiar pesos seleccionados"

#: res/xrc/OutfitStudio.xrc:2488 res/xrc/OutfitStudio.xrc:2984
msgid "Copies selected bone weights from the reference shape to the current shape."
msgstr "Copia los pesos de hueso seleccionados de la forma de referencia a la forma actual."

#: res/xrc/OutfitStudio.xrc:2492 res/xrc/OutfitStudio.xrc:2988
