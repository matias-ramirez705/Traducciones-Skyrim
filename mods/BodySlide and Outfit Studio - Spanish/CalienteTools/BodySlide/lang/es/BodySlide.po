#: res/xrc/Automation.xrc:2992
msgid "Default big value (0-100). Leave empty for no change."
msgstr "Valor grande predeterminado (0-100). Dejar en blanco para no cambiar."

#: res/xrc/Automation.xrc:3007
msgid "Set Shader Properties"
msgstr "Establecer propiedades del shader"

#: res/xrc/Automation.xrc:3033
