msgstr "Eliminar"

#: res/xrc/Automation.xrc:49
msgid "Delete the current automation script"
msgstr "Eliminar el script de automatización actual"

#: res/xrc/Automation.xrc:57
msgid "Open Folder"
msgstr "Abrir carpeta"

#: res/xrc/Automation.xrc:58
msgid "Open the Automations folder in file explorer"
msgstr "Abrir la carpeta de Automatizations en el explorador de archivos"

#: res/xrc/Automation.xrc:99
msgid "Step Settings"
msgstr "Configuración de pasos"

#: res/xrc/Automation.xrc:114
msgid "Type:"
msgstr "Tipo:"

#: res/xrc/Automation.xrc:121
msgid "Pick the operation this step performs. The types are grouped by category and the popup can be filtered by typing."
msgstr "Elige la operación que realiza este paso. Los tipos están agrupados por categoría y el menú emergente se puede filtrar escribiendo."

#: res/xrc/Automation.xrc:128
msgid "Active:"
msgstr "Activo:"

#: res/xrc/Automation.xrc:134
msgid "Execute this step"
msgstr "Ejecutar este paso"

#: res/xrc/Automation.xrc:142
msgid "Target Shapes:"
msgstr "Formas Destino:"

