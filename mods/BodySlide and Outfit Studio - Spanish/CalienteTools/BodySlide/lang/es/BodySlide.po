#: res/xrc/Actions.xrc:1978 res/xrc/OutfitStudio.xrc:407 res/xrc/OutfitStudio.xrc:3027 res/xrc/OutfitStudio.xrc:3071 src/components/Automation.cpp:199 src/components/Automation.cpp:211 src/components/Automation.cpp:216 src/components/Automation.cpp:224 src/components/Automation.cpp:230 src/components/Automation.cpp:236 src/components/Automation.cpp:248 src/components/Automation.cpp:254
msgid "Bones"
