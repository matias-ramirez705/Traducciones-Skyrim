#: res/xrc/Actions.xrc:110
msgid "Move Shape"
msgstr "Mover forma"

#: res/xrc/Actions.xrc:254
msgid "Mirror Axis"
msgstr "Eje de simetría"

#: res/xrc/Actions.xrc:320
msgid "Scale Shape"
msgstr "Escalar forma"

#: res/xrc/Actions.xrc:329
msgid "Scaling will adjust the size of a mesh. This permanently affects vertices."
msgstr "El escalado ajustará el tamaño de una malla. Esto afecta permanentemente a los vértices."

#: res/xrc/Actions.xrc:461 res/xrc/Actions.xrc:667 res/xrc/ShapeProperties.xrc:1614 res/xrc/Skeleton.xrc:133
msgid "Origin"
msgstr "Origen"

#: res/xrc/Actions.xrc:472 res/xrc/Actions.xrc:678
msgid "Zero (0, 0, 0)"
msgstr "Cero (0, 0, 0)"

#: res/xrc/Actions.xrc:473 res/xrc/Actions.xrc:679
msgid "Center of selected shapes(s)"
msgstr "Centro de las formas seleccionadas"

#: res/xrc/Actions.xrc:484 res/xrc/Actions.xrc:847
msgid "Uniform (XYZ)"
msgstr "Uniforme (XYZ)"

#: res/xrc/Actions.xrc:517
msgid "Rotate Shape"
msgstr "Rotar forma"

#: res/xrc/Actions.xrc:712
msgid "Inflate Shape"
msgstr "Inflar forma"

#: res/xrc/Actions.xrc:721
msgid "Inflate/deflate a mesh along its normals. This permanently affects vertices."
msgstr "Inflar/desinflar una malla a lo largo de sus normales. Esto afecta permanentemente a los vértices."

#: res/xrc/Actions.xrc:880 res/xrc/Automation.xrc:1877
msgid "Mirror Shape"
msgstr "Simetrizar forma"

#: res/xrc/Actions.xrc:924
msgid "Swap bones on X axis (L/R)"
msgstr "Intercambiar huesos en el eje X (I/D)"

#: res/xrc/Actions.xrc:956
msgid "Smooth Seams"
msgstr "Suavizar uniones"

#: res/xrc/Actions.xrc:1032
msgid "Set Shape Textures"
msgstr "Establecer texturas de forma"

#: res/xrc/Actions.xrc:1079
msgid "Conforming..."
msgstr "Conformando..."

#: res/xrc/Actions.xrc:1088
msgid "Use Default or pick a preset, then adjust only what needs a different result. Hover options for details; some meshes still need manual cleanup."
msgstr "Usa el predeterminado o elige un preajuste, luego ajusta solo lo que necesita un resultado diferente. Pasa el ratón sobre las opciones para ver detalles; algunas mallas aún necesitan limpieza manual."

#: res/xrc/Actions.xrc:1098
msgid "Search"
msgstr "Buscar"

#: res/xrc/Actions.xrc:1104
msgid "Higher values blend more vertices; lower values stay more local."
msgstr "Los valores más altos mezclan más vértices; los valores más bajos permanecen más locales."

#: res/xrc/Actions.xrc:1121
msgid "Radius"
msgstr "Radio"

#: res/xrc/Actions.xrc:1122 res/xrc/Actions.xrc:1133 res/xrc/Actions.xrc:1141
msgid "Distance around each outfit vertex to search for reference vertices. Larger values find more matches but can cross into nearby unrelated geometry."
msgstr "Distancia alrededor de cada vértice del atuendo para buscar vértices de referencia. Los valores más grandes encuentran más coincidencias pero pueden cruzar hacia geometría no relacionada cercana."

#: res/xrc/Actions.xrc:1147
msgid "Max Targets"
msgstr "Máx. destinos"

#: res/xrc/Actions.xrc:1148 res/xrc/Actions.xrc:1159 res/xrc/Actions.xrc:1167
msgid "Limits how many nearby reference vertices are blended for each outfit vertex. Lower values favor closest matches; higher values average more movement."
msgstr "Limita cuántos vértices de referencia cercanos se mezclan para cada vértice del atuendo. Los valores más bajos favorecen las coincidencias más cercanas; los valores más altos promedian más movimiento."

#: res/xrc/Actions.xrc:1173 res/xrc/WeightCopy.xrc:95
msgid "No Target Limit"
msgstr "Sin límite de destinos"

#: res/xrc/Actions.xrc:1174 res/xrc/Actions.xrc:1182
msgid "Uses every matching reference vertex inside the search radius and disables Max Vertex Targets. Turning this on sets the radius to 5.0."
msgstr "Usa cada vértice de referencia coincidente dentro del radio de búsqueda y deshabilita los Máx. destinos de vértice. Activar esto establece el radio en 5.0."

#: res/xrc/Actions.xrc:1198
msgid "Delta Smoothing"
msgstr "Suavizado delta"

#: res/xrc/Actions.xrc:1204
msgid "Softens jagged slider deltas after conforming."
msgstr "Suaviza deltas desiguales del deslizador después de conformar."

#: res/xrc/Actions.xrc:1220
msgid "Smooth Deltas"
msgstr "Suavizar deltas"

#: res/xrc/Actions.xrc:1221 res/xrc/Actions.xrc:1229
msgid "Runs a smoothing pass on the conformed slider data before it is saved to the outfit shape."
msgstr "Ejecuta un paso de suavizado en los datos del deslizador conformados antes de guardarlos en la forma del atuendo."

#: res/xrc/Actions.xrc:1235
msgid "Iterations"
msgstr "Iteraciones"

#: res/xrc/Actions.xrc:1236 res/xrc/Actions.xrc:1245
msgid "Number of smoothing passes. More passes spread movement farther and make the result softer."
msgstr "Número de pasajes de suavizado. Más pasajes propagan el movimiento más lejos y hacen el resultado más suave."

#: res/xrc/Actions.xrc:1251
msgid "Strength (0-1)"
msgstr "Fuerza (0-1)"

#: res/xrc/Actions.xrc:1252 res/xrc/Actions.xrc:1261
msgid "Blend amount for each smoothing pass. 0 leaves the deltas unchanged; 1 applies the strongest smoothing."
msgstr "Cantidad de mezcla para cada paso de suavizado. 0 deja los deltas sin cambios; 1 aplica el suavizado más fuerte."

#: res/xrc/Actions.xrc:1274
msgid "Clipping Fix"
msgstr "Corrección de recorte"

#: res/xrc/Actions.xrc:1280
msgid "Reduces intersections in the new slider deltas."
msgstr "Reduce las intersecciones en los nuevos deltas del deslizador."

#: res/xrc/Actions.xrc:1296 res/xrc/Automation.xrc:1763 res/xrc/BodySlide.xrc:484 src/program/OutfitStudio.cpp:10478 src/program/OutfitStudio.cpp:10542 src/program/OutfitStudio.cpp:10548 src/program/OutfitStudio.cpp:11686
msgid "Fix Clipping"
msgstr "Corregir recorte"

#: res/xrc/Actions.xrc:1297 res/xrc/Actions.xrc:1305
msgid "After each slider is conformed, adjust the result to reduce intersections with the reference shape."
msgstr "Después de que cada deslizador se conforma, ajusta el resultado para reducir las intersecciones con la forma de referencia."

#: res/xrc/Actions.xrc:1311
msgid "Strength (%)"
msgstr "Fuerza (%)"

#: res/xrc/Actions.xrc:1312 res/xrc/Actions.xrc:1322
msgid "How strongly to apply the clipping correction. Higher values push more of the correction into the conformed slider."
msgstr "Qué tan fuertemente aplicar la corrección de recorte. Los valores más altos empujan más de la corrección hacia el deslizador conformado."

#: res/xrc/Actions.xrc:1335
msgid "Shape Movement"
msgstr "Movimiento de forma"

#: res/xrc/Actions.xrc:1341
msgid "Useful for rigid shapes or limiting movement axes."
msgstr "Útil para formas rígidas o para limitar los ejes de movimiento."

#: res/xrc/Actions.xrc:1357
msgid "No X Squeeze"
msgstr "Sin compresión en X"

#: res/xrc/Actions.xrc:1358 res/xrc/Actions.xrc:1366
msgid "Only copies X movement that stays on the same side of the reference. Helps avoid left/right squeezing across the center line."
msgstr "Solo copia el movimiento en X que permanece en el mismo lado de la referencia. Ayuda a evitar la compresión izquierda/derecha a través de la línea central."

#: res/xrc/Actions.xrc:1372
msgid "Solid Mode"
msgstr "Modo sólido"

#: res/xrc/Actions.xrc:1373 res/xrc/Actions.xrc:1381
msgid "Uses one combined movement for the entire shape instead of separate per-vertex movement. Useful for rigid accessories or solid objects."
msgstr "Usa un movimiento combinado para toda la forma en lugar de un movimiento por vértice separado. Útil para accesorios rígidos u objetos sólidos."

#: res/xrc/Actions.xrc:1387
msgid "Axes"
msgstr "Ejes"

#: res/xrc/Actions.xrc:1388
msgid "Choose which axes are allowed to receive copied movement. Unchecked axes keep their existing slider movement."
msgstr "Elige qué ejes están permitidos para recibir movimiento copiado. Los ejes desmarcados mantienen su movimiento existente del deslizador."

#: res/xrc/Actions.xrc:1402
msgid "Allow conforming to write X-axis movement."
msgstr "Permitir que el conformado escriba movimiento en el eje X."

#: res/xrc/Actions.xrc:1411
msgid "Allow conforming to write Y-axis movement."
msgstr "Permitir que el conformado escriba movimiento en el eje Y."

#: res/xrc/Actions.xrc:1418
msgid "Allow conforming to write Z-axis movement."
msgstr "Permitir que el conformado escriba movimiento en el eje Z."

#: res/xrc/Actions.xrc:1433
msgid "Presets"
msgstr "Preajustes"

#: res/xrc/Actions.xrc:1445 src/program/OutfitStudio.cpp:10347
msgid "Default"
msgstr "Predeterminado"

#: res/xrc/Actions.xrc:1446
msgid "Radius 10, max 10, no smoothing or clipping fix. Good starting point for most outfits."
msgstr "Radio 10, máximo 10, sin suavizado ni corrección de recorte. Buen punto de partida para la mayoría de los atuendos."

#: res/xrc/Actions.xrc:1454
msgid "Even Movement"
msgstr "Movimiento uniforme"

#: res/xrc/Actions.xrc:1455
msgid "Radius 5, no target limit, and No Squeeze enabled. Helps soft shapes move more evenly without pulling across the center line."
msgstr "Radio 5, sin límite de destino, y Sin compresión habilitado. Ayuda a que las formas suaves se muevan más uniformemente sin tirar a través de la línea central."

#: res/xrc/Actions.xrc:1463
msgid "Smooth Clipping"
msgstr "Recorte suave"

#: res/xrc/Actions.xrc:1464
msgid "Even Movement plus smoothing and clipping fix. Useful when conforming creates noisy deltas or small intersections."
msgstr "Movimiento uniforme más suavizado y corrección de recorte. Útil cuando el conformado crea deltas ruidosos o intersecciones pequeñas."

#: res/xrc/Actions.xrc:1470
msgid "Solid Object"
msgstr "Objeto sólido"

#: res/xrc/Actions.xrc:1471
msgid "No target limit and Solid Mode enabled. Useful for rigid meshes that should move as one piece."
msgstr "Sin límite de destino y Modo sólido habilitado. Útil para mallas rígidas que deben moverse como una sola pieza."

#: res/xrc/Actions.xrc:1504 res/xrc/Automation.xrc:3501
msgid "Merge Geometry"
msgstr "Combinar geometría"

#: res/xrc/Actions.xrc:1513
msgid "This function copies vertices and triangles from one shape to another.  Partitions/segments of source and target shapes must match.  It is the user's responsibility to check that all other shape and shader properties are compatible, or merging will likely have side effects."
msgstr "Esta función copia vértices y triángulos de una forma a otra. Las particiones/segmentos de las formas de origen y destino deben coincidir. Es responsabilidad del usuario verificar que todas las demás propiedades de forma y shader sean compatibles, o la combinación probablemente tendrá efectos secundarios."

#: res/xrc/Actions.xrc:1528 res/xrc/Actions.xrc:1630 src/program/SliderDataDialog.cpp:36
msgid "Source"
msgstr "Origen"

#: res/xrc/Actions.xrc:1546 src/program/AutomationDialog.cpp:530 src/program/SliderDataDialog.cpp:34
msgid "Target"
msgstr "Destino"

#: res/xrc/Actions.xrc:1575
msgid "Delete source shape"
msgstr "Eliminar forma de origen"

#: res/xrc/Actions.xrc:1604 src/program/OutfitStudio.cpp:13683
msgid "Copy Mask"
msgstr "Copiar máscara"

#: res/xrc/Actions.xrc:1613
msgid "Copies the current mask of the source shape to the target shapes. Each target vertex takes the mask of the closest part of the source surface, so the shapes can have different vertices but should overlap where the mask is needed."
msgstr "Copia la máscara actual de la forma de origen a las formas de destino. Cada vértice de destino toma la máscara de la parte más cercana de la superficie de origen, por lo que las formas pueden tener distintos vértices, pero deben superponerse donde se necesite la máscara."

#: res/xrc/Actions.xrc:1642
msgid "Max Distance"
msgstr "Distancia máxima"

#: res/xrc/Actions.xrc:1643 res/xrc/Actions.xrc:1651
msgid "Target vertices farther than this from the source surface don't get any mask from it. Keep it low so that unrelated nearby geometry isn't masked."
msgstr "Los vértices de destino que superen esta distancia respecto a la superficie de origen no recibirán ninguna máscara. Mantén este valor bajo para evitar enmascarar geometría cercana que no esté relacionada."

#: res/xrc/Actions.xrc:1661
msgid "Targets"
msgstr "Destinos"

#: res/xrc/Actions.xrc:1678
msgid "Add to the existing mask"
msgstr "Añadir a la máscara existente"

#: res/xrc/Actions.xrc:1679
msgid "Keeps the current mask of the target shapes and only adds the copied mask to it. Otherwise the target mask is replaced."
msgstr "Conserva la máscara actual de las formas de destino y solo añade la máscara copiada. De lo contrario, la máscara de destino se reemplaza."

#: res/xrc/Actions.xrc:1709
msgid "Mask symmetric vertices"
msgstr "Máscara de vértices simétricos"

#: res/xrc/Actions.xrc:1718
msgid "Masks all vertices that do not have any of the selected asymmetries."
msgstr "Mascara todos los vértices que no tienen ninguna de las asimetrías seleccionadas."

#: res/xrc/Actions.xrc:1744
msgid "Vertices currently unmasked:"
msgstr "Vértices actualmente sin máscara:"

#: res/xrc/Actions.xrc:1772
msgid "Unmatched Vertices:"
msgstr "Vértices no coincidentes:"

#: res/xrc/Actions.xrc:1794
msgid "Vertex Data Asymmetries"
msgstr "Asimetrías de datos de vértices"

