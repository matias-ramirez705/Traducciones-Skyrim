  {
    "editor_id": "null",
    "form_id": "05000882|mihailhavocrelsandruinachs.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Foolish mortal! Nobody can stop Mehrunes Dagon's fifth hand!",
    "string": "¡Tonto mortal! ¡Nadie puede detener la quinta mano de Mehrunes Dagon!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "05000883|mihailhavocrelsandruinachs.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "I will bring destruction and death into your life, worm!",
    "string": "¡Traeré destrucción y muerte a tu vida, gusano!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "05000884|mihailhavocrelsandruinachs.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "May the wrath of Dagon decimate your pitiful existence!",
    "string": "¡Que la ira de Dagon diezme tu lamentable existencia!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "05000885|mihailhavocrelsandruinachs.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "You will be charred in my hands, and your corpse desecrated in Oblivion!",
    "string": "¡Serás carbonizado en mis manos, y tu cadáver profanado en Oblivion!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "05000A65|mihailhavocrelsandruinachs.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Your soul will be my offering to the Prince of Destruction!",
    "string": "¡Tu alma será mi ofrenda al Príncipe de la Destrucción!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "05000A66|mihailhavocrelsandruinachs.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "I was born of Dagon's own flesh, and no one can destroy one of his Harbingers!",
    "string": "Nací de la propia carne de Dagón, ¡y nadie puede destruir a uno de sus Precursores!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "05000A67|mihailhavocrelsandruinachs.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "This is the day you will meet the terrible power of the Ruinachs!",
    "string": "¡Este es el día en que te encontrarás con el terrible poder de los Ruinachs!",
    "status": "TranslationComplete"
  },
