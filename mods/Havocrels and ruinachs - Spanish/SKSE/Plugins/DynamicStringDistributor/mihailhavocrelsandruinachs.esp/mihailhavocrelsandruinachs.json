  {
    "editor_id": "null",
    "form_id": "05000853|mihailhavocrelsandruinachs.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "I'll tear you from the face of this realm!",
    "string": "¡Te arrancaré de la faz de este reino!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "05000854|mihailhavocrelsandruinachs.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "You will be unmade by my hands!",
    "string": "¡Serás deshecho por mis manos!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "05000855|mihailhavocrelsandruinachs.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Blasted insect! You will know the wrath of an Havocrel!",
    "string": "¡Maldito insecto! ¡Conocerás la ira de un Havocrel!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "05000856|mihailhavocrelsandruinachs.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Laughable weakling, you have no power here!",
    "string": "¡Enclenque risible, aquí no tienes poder!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "05000857|mihailhavocrelsandruinachs.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "You will be destroyed for your audacity, puny weakling!",
    "string": "¡Serás destruido por tu audacia, enclenque!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "05000858|mihailhavocrelsandruinachs.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "You are outclassed and outmatched, puny flea!",
    "string": "¡Te superan, pulga enclenque!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "05000859|mihailhavocrelsandruinachs.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "You won't last much longer!",
    "string": "¡No durarás mucho más!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "05000816|mihailhavocrelsandruinachs.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Can your insignificance be more apparent? You're pathetic! You can't be my enemy, you are too weak for that role! ",
    "string": "¿Puede ser más evidente tu insignificancia? ¡Eres patético! No puedes ser mi enemigo, ¡eres demasiado débil para ese papel! ",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "05000819|mihailhavocrelsandruinachs.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Grow, maggot! Grow into something strong! You are weak!",
    "string": "¡Crece, gusano! ¡Crece en algo fuerte! ¡Eres débil!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "0500081A|mihailhavocrelsandruinachs.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "It will take more than this to destroy me!",
    "string": "¡Se necesitará más que esto para destruirme!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "0500085A|mihailhavocrelsandruinachs.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Only cowards will mourn you!",
    "string": "¡Sólo los cobardes te llorarán!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "0500085C|mihailhavocrelsandruinachs.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Face me, insect! Your death is my burden!",
    "string": "¡Enfréntame, insecto! ¡Tu muerte es mi carga!",
    "status": "TranslationComplete"
  },
