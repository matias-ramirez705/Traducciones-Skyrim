{
  "$schema": "https://raw.githubusercontent.com/Exit-9B/MCM-Helper/main/docs/config.schema.json",
  "modName": "AchievementInjector",
  "displayName": "Inyector de logros",
  "minMcmVersion": 9,
  "cursorFillMode": "topToBottom",
  "content": [
    {
      "type": "header",
      "text": "Para jugadores"
    },
    {
      "id": "bGlobal:Main",
      "type": "toggle",
      "text": "Activar perfil global",
      "help": "Activa esta opción si quieres que todos los personajes compartan los mismos logros.",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      }
    },
    {
      "id": "bUsePopup:Main",
      "type": "toggle",
      "text": "Activar ventanas emergentes al completar logros",
      "help": "Activa o desactiva las ventanas emergentes en la esquina superior derecha de la pantalla para avisarte cuando desbloquees un logro.",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      }
    },
    {
      "id": "iWidgetYOffset:Main",
      "type": "slider",
      "text": "Desplazamiento vertical del widget",
      "help": "Establece el desplazamiento vertical del widget de notificaciones.",
      "valueOptions": {
        "sourceType": "ModSettingInt",
        "min": -10,
        "max": 565,
        "step": 1,
        "defaultValue": 0
      }
    },
    {
      "id": "fWidgetScale:Main",
      "type": "slider",
      "text": "Escala del widget",
      "help": "Establece la escala del widget de notificaciones.",
      "valueOptions": {
        "sourceType": "ModSettingFloat",
        "min": 0.1,
        "max": 2.0,
        "step": 0.1,
        "defaultValue": 1.0,
        "formatString": "{1}"
      }
    },
    {
      "id": "bShowHidden:Main",
      "type": "toggle",
      "text": "Mostrar logros ocultos",
      "help": "Muestra los logros que los autores de los mods marcaron como ocultos hasta que se desbloqueen.",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      }
    },
    {
      "type": "empty"
    },
    {
      "id": "iNotificationSound:Sound",
      "type": "enum",
      "text": "Sonido de notificación",
      "help": "Selecciona el sonido predeterminado que se reproducirá al desbloquear un logro. Los autores pueden definir sonidos personalizados para cada logro.",
      "valueOptions": {
        "options": [
          "UISkillIncreaseSD",
          "UIQuestComplete",
          "UISkillsForward",
          "UIStartNewGame",
          "UINewShoutLearned"
        ],
        "sourceType": "ModSettingInt",
        "defaultValue": 0
      }
    },
    {
      "id": "bMute:Sound",
      "type": "toggle",
      "text": "Silenciar",
      "help": "Activa esta opción si quieres silenciar todos los sonidos de notificación.",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      }
    },
    {
      "id": "bOverrideNotificationSound:Sound",
      "type": "toggle",
      "text": "Reemplazar sonidos de notificación",
      "help": "Activa esta opción si quieres reemplazar los sonidos de notificación proporcionados por los autores por el sonido que elijas.",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      }
    },
    {
      "type": "empty"
    },
    {
      "type": "header",
      "text": "Para desarrolladores"
    },
    {
      "id": "bDebug:Main",
      "type": "toggle",
      "text": "Activar registros de depuración",
      "help": "Activa esta opción si quieres que los registros muestren todos los mensajes. Esto puede ser útil para los desarrolladores.",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      }
    }
  ]
}