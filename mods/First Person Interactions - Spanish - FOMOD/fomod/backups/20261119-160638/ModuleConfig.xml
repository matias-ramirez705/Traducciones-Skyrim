<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
	<moduleName>First Person Interactions - Spanish</moduleName>
	<installSteps order="Explicit">
		<installStep name="Instalacion">
			<optionalFileGroups>
				<group name="Core Files" type="SelectExactlyOne">
					<plugins order="Explicit">
						<plugin name="Main mod">
							<description>Mod Principal.</description>
							<files>
								<folder source="Main files" destination="" priority="0"/>
							</files>
							<typeDescriptor>
								<type name="Required"/>
							</typeDescriptor>
						</plugin>
					</plugins>
				</group>
				<group name="Compatibilidad" type="SelectAny">
					<plugins order="Explicit">
						<plugin name="Dynamic Activation Key">
							<description>Utiliza la función de clave de activación dinámica para agregar nuevas interacciones mientras estás en primera persona: aplaude a los bardos, saluda a los niños y acaricia a los animales.</description>
							<files>
								<folder source="Optionals\DAK - Addons\FirstPersonInteractions_Addon.esp" destination="SKSE\Plugins\DynamicStringDistributor\FirstPersonInteractions_Addon.esp" priority="0"/>
							</files>
							<typeDescriptor>
								<dependencyType>
									<defaultType name="Optional"/>
									<patterns>
										<pattern>
											<dependencies operator="And">
												<fileDependency file="FirstPersonInteractions_Addon.esp" state="Active"/>
											</dependencies>
											<type name="Recommended"/>
										</pattern>
										<pattern>
											<dependencies operator="Or">
												<fileDependency file="FirstPersonInteractions_Addon.esp" state="Inactive"/>
												<fileDependency file="FirstPersonInteractions_Addon.esp" state="Missing"/>
											</dependencies>
											<type name="NotUsable"/>
										</pattern>
									</patterns>
								</dependencyType>
							</typeDescriptor>
						</plugin>
						<plugin name="Sure of Stealing">
							<description>Parche de integración. Requiere Interacciones Inmersivas, Clave de Activación Dinámica y el archivo de complementos para Interacciones en Primera Persona.

https://www.nexusmods.com/skyrimspecialedition/mods/93682</description>
							<files>
								<folder source="Optionals\Sure of Stealing\Sure of Stealing - Immersive Interactions Patch.esp" destination="SKSE\Plugins\DynamicStringDistributor\Sure of Stealing - Immersive Interactions Patch.esp" priority="0"/>
							</files>
							<typeDescriptor>
								<dependencyType>
									<defaultType name="Optional"/>
									<patterns>
										<pattern>
											<dependencies operator="Or">
												<fileDependency file="Sure of Stealing - Immersive Interactions Patch.esp" state="Inactive"/>
												<fileDependency file="Sure of Stealing - Immersive Interactions Patch.esp" state="Missing"/>
											</dependencies>
											<type name="NotUsable"/>
										</pattern>
										<pattern>
											<dependencies operator="And">
												<fileDependency file="Sure of Stealing - Immersive Interactions Patch.esp" state="Active"/>
											</dependencies>
											<type name="Recommended"/>
										</pattern>
									</patterns>
								</dependencyType>
							</typeDescriptor>
						</plugin>
						<plugin name="EatingSleepingDrinking">
							<description>Parche de integración.



https://www.nexusmods.com/skyrimspecialedition/mods/65868</description>
							<files>
								<folder source="Optionals\EatingSleepingDrinking" destination="" priority="0"/>
							</files>
							<typeDescriptor>
								<type name="Optional"/>
							</typeDescriptor>
						</plugin>
					</plugins>
				</group>
			</optionalFileGroups>
		</installStep>
	</installSteps>
</config>