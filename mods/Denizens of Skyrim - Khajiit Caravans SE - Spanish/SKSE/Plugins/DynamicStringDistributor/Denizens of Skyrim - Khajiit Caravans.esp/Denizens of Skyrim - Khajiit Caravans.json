    "string": "Oof!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "0100345A|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Aiiieeee!",
    "string": "Aiiieeee!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "0100345C|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Well.... done....",
    "string": "Bien.... hecho....",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "0100345E|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "I shall honor my Lord... by destroying you!",
    "string": "Honrare a mi Senor... destruyendote!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "0100345F|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "A challenger draws near!",
    "string": "Un retador se acerca!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "01003460|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "I smell your fear!",
    "string": "Huelo tu miedo!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "01003461|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "You will die this day, mortal filth!",
    "string": "Moriras hoy, inmundicia mortal!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "01003462|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "These bindings shall not prevent me from eradicating you!",
    "string": "Estas ataduras no me impediran erradicarte!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "01003463|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Your blood is forfeit, your flesh is mine!",
    "string": "Tu sangre es mia, tu carne me pertenece!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "01003464|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Are you ready to die?!",
    "string": "Estas listo para morir?!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "01003465|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "May your \"Divines\" show you mercy, for I shall not!",
    "string": "Que tus 'Divinos' te muestren misericordia, porque yo no lo hare!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "01003466|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Suffer!",
    "string": "Sufre!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "01003467|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Weep, fettlekyn!",
    "string": "Llora, fettlekyn!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "01003468|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Kneel, churl!",
    "string": "Arrodillate, churl!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "01003469|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Kyn, and Valkyn!",
    "string": "Kyn y Valkyn!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "0100346A|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Burst, fleshbag!",
    "string": "Explota, saco de carne!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "0100346B|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Open wide!",
    "string": "Abre bien!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "0100346C|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Time to bleed you dry!",
    "string": "Hora de drenarte hasta secarte!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "0100346D|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Your death draws near!",
    "string": "Tu muerte se acerca!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "0100346E|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "A worthy challenger has appeared! Now you shall die!",
    "string": "Ha aparecido un retador digno! Ahora moriras!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "0100346F|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Fall to me, dragon!",
    "string": "Cae ante mi, dragon!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "01003470|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Your scales are now my trophies!",
    "string": "Tus escamas ahora son mis trofeos!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "01003471|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Slay the dragon!",
    "string": "Mata al dragon!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "01003472|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Land! So I may slaughter you!",
    "string": "Aterriza! Para que pueda masacrarte!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "01003474|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "S..strong...",
    "string": "F..fuerte...",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "01003475|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Powerful....",
    "string": "Poderoso....",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "01003476|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Your strength... is admirable...",
    "string": "Tu fuerza... es admirable...",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "01003478|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Not.... today....",
    "string": "No.... hoy....",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "01003479|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "I won't.... be done in.... by a mortal...",
    "string": "No.... caere.... ante.... un mortal...",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "0100347A|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "No... Not... Like this...",
    "string": "No... No... Asi no...",
    "status": "TranslationComplete"
  }
]