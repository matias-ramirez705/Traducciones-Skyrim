  {
    "editor_id": "null",
    "form_id": "0100343E|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Pitiful mortal scum. Death would be a mercy compared to the life you live.",
    "string": "Patetica escoria mortal. La muerte seria una misericordia comparada con la vida que llevas.",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "01003443|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "These Khajiit are despicable. Binding me to their will, and forcing me to do as they wish. If only I could drain them of their blood.",
    "string": "Estos khajiit son despreciables. Atandome a su voluntad y obligandome a hacer lo que desean. Si tan solo pudiera drenarles la sangre.",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "01003444|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "What do you want, feeble mortal?",
    "string": "Que quieres, mortal debil?",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "01003445|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Do you seek death? I will grant you that wish if you continue to bother me.",
    "string": "Buscas la muerte? Te concedere ese deseo si sigues molestandome.",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "01003446|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "What is it, mortal scum?",
    "string": "Que es lo que quieres, escoria mortal?",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "01003447|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Bastard mortals.",
    "string": "Mortales bastardos.",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "01003448|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Do you wish to die where you stand? If not, leave me be!",
    "string": "Deseas morir donde estas? Si no, dejame en paz!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "01003449|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Do not trifle with the Khajiit, and I will not trifle with you.",
    "string": "No juegues con los khajiit y yo no jugare contigo.",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "0100344B|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Take that!",
    "string": "Toma esto!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "0100344C|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Hah!",
    "string": "Hah!",
    "status": "TranslationComplete"
  },
  {
    "editor_id": "null",
    "form_id": "0100344D|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Eyyagh!",
    "string": "Eyyagh!",
    "status": "TranslationComplete"
  },
  {
