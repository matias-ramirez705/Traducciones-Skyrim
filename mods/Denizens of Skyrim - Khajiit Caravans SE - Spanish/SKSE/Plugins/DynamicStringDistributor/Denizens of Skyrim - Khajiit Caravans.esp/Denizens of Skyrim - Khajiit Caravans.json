    "form_id": "0100344E|Denizens of Skyrim - Khajiit Caravans.esp",
    "index": 1,
    "type": "INFO NAM1",
    "original": "Die, mortal filth!",
    "string": "Muere, inmundicia mortal!",
    "status": "TranslationComplete"
  },
  {
